{
  "version": 3,
  "configurePresets": [
    {
      "name": "msvc-vcpkg",
      "displayName": "MSVC 2022 x64 + vcpkg",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "VCPKG_MANIFEST_MODE": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "msvc-vcpkg", "configuration": "Release" },
    { "name": "debug", "configurePreset": "msvc-vcpkg", "configuration": "Debug" }
  ]
}
