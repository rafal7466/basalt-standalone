{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure (CMake + vcpkg)",
      "type": "shell",
      "command": "cmake --preset msvc-vcpkg",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Build Release",
      "type": "shell",
      "command": "cmake --build --preset release --parallel",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Run unit tests",
      "type": "shell",
      "command": "${workspaceFolder}/build/Release/bw_tests.exe",
      "dependsOn": "Build Release",
      "problemMatcher": []
    },
    {
      "label": "Run VIO on EuRoC MH_01",
      "type": "shell",
      "command": "${workspaceFolder}/build/Release/bw_vio.exe",
      "args": [
        "--dataset", "${workspaceFolder}/dataset/MH_01_easy",
        "--out", "${workspaceFolder}/results/MH_01"
      ],
      "dependsOn": "Build Release",
      "problemMatcher": []
    }
  ]
}
